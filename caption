#!/usr/bin/env bash
#
# caption — generate captions/subtitles for a video using whisper.cpp + ffmpeg
#
# Usage:
#   caption [options] <video-file>
#
# It extracts the audio track with ffmpeg, transcribes it with whisper-cli
# (whisper.cpp), and writes subtitle files (SRT/VTT/TXT) next to the video.
# Optionally it can burn the subtitles into a copy of the video.
#
set -euo pipefail

VERSION="0.1.0"

# ---------------------------------------------------------------------------
# Defaults (override with flags or environment variables)
# ---------------------------------------------------------------------------
MODEL="${WHISPER_MODEL:-}"          # path to a ggml-*.bin model file
MODEL_SIZE="${WHISPER_MODEL_SIZE:-base.en}"
LANGUAGE="${WHISPER_LANGUAGE:-auto}"
FORMAT="srt"                        # srt | vtt | txt | all
OUTDIR=""                           # defaults to the input file's directory
BURN=0                              # 1 = also produce a subtitled video copy
KEEP_WAV=0                          # 1 = keep the intermediate wav file
THREADS="$(nproc 2>/dev/null || echo 4)"

# whisper.cpp CLI binary — accept a couple of common names.
WHISPER_BIN="${WHISPER_BIN:-}"

# Where to cache auto-downloaded models.
MODEL_CACHE="${WHISPER_MODEL_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/whisper.cpp}"
MODEL_BASE_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
prog="$(basename "$0")"

log()  { printf '\033[1;34m[caption]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[caption]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[caption] error:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
$prog $VERSION — caption a video with whisper.cpp + ffmpeg

Usage:
  $prog [options] <video-file>

Options:
  -m, --model PATH       Path to a whisper ggml model (.bin). If omitted, a
                         model of size --model-size is downloaded and cached.
      --model-size SIZE  Model to auto-download when -m is not given
                         (e.g. tiny, tiny.en, base, base.en, small, medium,
                         large-v3). Default: $MODEL_SIZE
  -l, --language LANG    Spoken language code, or "auto" to detect.
                         Default: $LANGUAGE
  -f, --format FMT       Subtitle format: srt, vtt, txt, or all. Default: $FORMAT
  -o, --output DIR       Output directory. Default: alongside the input file.
  -b, --burn             Also render <name>.captioned.mp4 with burned-in subs.
  -t, --threads N        Threads for whisper-cli. Default: $THREADS
      --keep-wav         Keep the intermediate 16 kHz wav file.
  -h, --help             Show this help.
  -V, --version          Show version.

Environment:
  WHISPER_BIN            Path/name of the whisper.cpp binary (auto-detected).
  WHISPER_MODEL          Default model path (same as -m).
  WHISPER_MODEL_SIZE     Default model size for auto-download.
  WHISPER_MODEL_DIR      Model cache directory (default: $MODEL_CACHE).
  WHISPER_LANGUAGE       Default language.

Examples:
  $prog talk.mp4
  $prog --model-size small -l en -f all clip.mov
  $prog -m ~/models/ggml-base.en.bin -b interview.mkv
EOF
}

# Locate the whisper.cpp CLI. Upstream renamed "main" -> "whisper-cli".
find_whisper_bin() {
  if [[ -n "$WHISPER_BIN" ]]; then
    command -v "$WHISPER_BIN" >/dev/null 2>&1 && { echo "$WHISPER_BIN"; return 0; }
    [[ -x "$WHISPER_BIN" ]] && { echo "$WHISPER_BIN"; return 0; }
    die "WHISPER_BIN='$WHISPER_BIN' is not executable or on PATH"
  fi
  local c
  for c in whisper-cli whisper.cpp whisper-cpp whisper main; do
    command -v "$c" >/dev/null 2>&1 && { echo "$c"; return 0; }
  done
  return 1
}

download_model() {
  local size="$1"
  local dest="$MODEL_CACHE/ggml-${size}.bin"
  if [[ -f "$dest" ]]; then
    echo "$dest"
    return 0
  fi
  command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 \
    || die "need curl or wget to download the '$size' model"
  mkdir -p "$MODEL_CACHE"
  local url="$MODEL_BASE_URL/ggml-${size}.bin"
  log "downloading model '$size' -> $dest"
  local tmp="$dest.part"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --progress-bar -o "$tmp" "$url" || { rm -f "$tmp"; die "download failed: $url"; }
  else
    wget -q --show-progress -O "$tmp" "$url" || { rm -f "$tmp"; die "download failed: $url"; }
  fi
  mv "$tmp" "$dest"
  echo "$dest"
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
INPUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--model)       MODEL="${2:-}"; shift 2 ;;
    --model-size)     MODEL_SIZE="${2:-}"; shift 2 ;;
    -l|--language)    LANGUAGE="${2:-}"; shift 2 ;;
    -f|--format)      FORMAT="${2:-}"; shift 2 ;;
    -o|--output)      OUTDIR="${2:-}"; shift 2 ;;
    -b|--burn)        BURN=1; shift ;;
    -t|--threads)     THREADS="${2:-}"; shift 2 ;;
    --keep-wav)       KEEP_WAV=1; shift ;;
    -h|--help)        usage; exit 0 ;;
    -V|--version)     echo "$prog $VERSION"; exit 0 ;;
    --)               shift; break ;;
    -*)               die "unknown option: $1 (see --help)" ;;
    *)                [[ -z "$INPUT" ]] && INPUT="$1" || die "unexpected argument: $1"; shift ;;
  esac
done
[[ -z "$INPUT" && $# -gt 0 ]] && INPUT="$1"

[[ -z "$INPUT" ]] && { usage; exit 1; }
[[ -f "$INPUT" ]] || die "input file not found: $INPUT"

case "$FORMAT" in srt|vtt|txt|all) ;; *) die "invalid --format: $FORMAT (srt|vtt|txt|all)";; esac

# ---------------------------------------------------------------------------
# Dependency checks
# ---------------------------------------------------------------------------
command -v ffmpeg >/dev/null 2>&1 || die "ffmpeg not found. Install it (e.g. 'apt install ffmpeg' or 'brew install ffmpeg')."

WHISPER="$(find_whisper_bin)" || die "whisper.cpp CLI not found. Build it from https://github.com/ggerganov/whisper.cpp and put 'whisper-cli' on PATH (or set WHISPER_BIN)."

# ---------------------------------------------------------------------------
# Resolve model
# ---------------------------------------------------------------------------
if [[ -n "$MODEL" ]]; then
  [[ -f "$MODEL" ]] || die "model file not found: $MODEL"
else
  MODEL="$(download_model "$MODEL_SIZE")"
fi

# ---------------------------------------------------------------------------
# Set up paths
# ---------------------------------------------------------------------------
in_dir="$(cd "$(dirname "$INPUT")" && pwd)"
base="$(basename "$INPUT")"
stem="${base%.*}"
out_dir="${OUTDIR:-$in_dir}"
mkdir -p "$out_dir"
out_prefix="$out_dir/$stem"

# Temp wav in the scratch dir (or output dir if we're keeping it).
if [[ "$KEEP_WAV" -eq 1 ]]; then
  wav="$out_prefix.wav"
else
  wav="$(mktemp --suffix=.wav 2>/dev/null || mktemp)"
fi
cleanup() { [[ "$KEEP_WAV" -eq 0 && -f "$wav" ]] && rm -f "$wav"; }
trap cleanup EXIT

# ---------------------------------------------------------------------------
# 1. Extract 16 kHz mono PCM audio (what whisper.cpp expects)
# ---------------------------------------------------------------------------
log "extracting audio: $INPUT -> 16 kHz mono wav"
ffmpeg -hide_banner -loglevel error -y -i "$INPUT" \
  -vn -ac 1 -ar 16000 -c:a pcm_s16le "$wav" \
  || die "ffmpeg failed to extract audio"

# ---------------------------------------------------------------------------
# 2. Transcribe with whisper.cpp
# ---------------------------------------------------------------------------
whisper_flags=(-m "$MODEL" -f "$wav" -t "$THREADS" -l "$LANGUAGE" -of "$out_prefix")
case "$FORMAT" in
  srt) whisper_flags+=(-osrt) ;;
  vtt) whisper_flags+=(-ovtt) ;;
  txt) whisper_flags+=(-otxt) ;;
  all) whisper_flags+=(-osrt -ovtt -otxt) ;;
esac

log "transcribing with $(basename "$WHISPER") (model: $(basename "$MODEL"), lang: $LANGUAGE)"
"$WHISPER" "${whisper_flags[@]}" || die "whisper transcription failed"

# ---------------------------------------------------------------------------
# 3. Report outputs (+ optionally burn subtitles in)
# ---------------------------------------------------------------------------
log "captions written:"
for ext in srt vtt txt; do
  [[ -f "$out_prefix.$ext" ]] && printf '  %s\n' "$out_prefix.$ext" >&2
done

if [[ "$BURN" -eq 1 ]]; then
  srt="$out_prefix.srt"
  [[ -f "$srt" ]] || die "--burn needs an SRT file; run with -f srt or -f all"
  captioned="$out_prefix.captioned.mp4"
  log "burning subtitles into $captioned"
  # Escape the subtitle path for ffmpeg's filter argument.
  esc_srt="${srt//\\/\\\\}"; esc_srt="${esc_srt//:/\\:}"; esc_srt="${esc_srt//\'/\\\'}"
  ffmpeg -hide_banner -loglevel error -y -i "$INPUT" \
    -vf "subtitles='${esc_srt}'" -c:a copy "$captioned" \
    || die "ffmpeg failed to burn subtitles"
  printf '  %s\n' "$captioned" >&2
fi

log "done."
